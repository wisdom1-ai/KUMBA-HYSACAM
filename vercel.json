{
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/[...route]?path=:path*" },
    { "source": "/", "destination": "/api/dashboard" },
    { "source": "/index.html", "destination": "/api/dashboard" }
  ],
  "functions": {
    "api/dashboard.js": { "includeFiles": "index.html" }
  }
}
